// STRATA — Spatial Topology, Registration and Administration of Three-dimensional Assets
// Prisma Schema Definition

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  PROPERTY_OWNER
  SURVEYOR
  REVIEWER
  REGISTRATION_OFFICER
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  REQUIRES_INFORMATION
  APPROVED
  REJECTED
  CANCELLED
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  MIXED_USE
  GOVERNMENT
  OTHER
}

enum ApplicationCommentType {
  GENERAL
  SYSTEM
}

enum ProjectStatus {
  INITIALIZED
  ACTIVE
  ON_HOLD
  CANCELLED
}

enum AssetType {
  PROPERTY_UNIT
  COMMON_AREA
  PARKING
  UTILITY
  INFRASTRUCTURE
  OTHER
}

enum ProcessingJobStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  REQUIRES_REVIEW
}

enum ViolationType {
  OVERLAP
  ENCROACHMENT
  BOUNDARY_CONFLICT
  VERTICAL_CONFLICT
  OTHER
}

enum ViolationSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(PROPERTY_OWNER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  projects            Project[]
  processingJobs      ProcessingJob[]
  auditLogs           AuditLog[]
  assignments         ProjectAssignment[]        @relation("userAssignments")
  assignmentsMade     ProjectAssignment[]        @relation("assignmentsMade")
  applications        PropertyApplication[]
  statusChanges       ApplicationStatusHistory[] @relation("statusChanges")
  applicationComments ApplicationComment[]       @relation("applicationComments")

  @@map("users")
}

model ApplicationCounter {
  year         Int @id
  lastSequence Int @default(0)

  @@map("application_counters")
}

model PropertyApplication {
  id                String            @id @default(uuid())
  applicationNumber String            @unique
  ownerId           String
  propertyName      String?
  propertyType      PropertyType?
  description       String?

  addressLine1      String?
  addressLine2      String?
  locality          String?
  city              String?
  district          String?
  state             String?
  country           String?
  postalCode        String?

  latitude          Float?
  longitude         Float?

  declaredArea          Float?
  declaredBuildingCount Int?
  declaredFloorCount    Int?

  status            ApplicationStatus @default(DRAFT)
  rejectionReason   String?

  submittedAt       DateTime?
  reviewStartedAt   DateTime?
  approvedAt        DateTime?

  projectId         String?           @unique

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Relationships
  owner         User                       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  project       Project?                   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  statusHistory ApplicationStatusHistory[]
  comments      ApplicationComment[]

  @@index([ownerId])
  @@index([status])
  @@map("property_applications")
}

model ApplicationStatusHistory {
  id            String            @id @default(uuid())
  applicationId String
  fromStatus    ApplicationStatus
  toStatus      ApplicationStatus
  changedById   String
  reason        String?
  createdAt     DateTime          @default(now())

  // Relationships
  application PropertyApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy   User                @relation("statusChanges", fields: [changedById], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_status_history")
}

model ApplicationComment {
  id            String                 @id @default(uuid())
  applicationId String
  authorId      String
  message       String
  type          ApplicationCommentType @default(GENERAL)
  createdAt     DateTime               @default(now())

  // Relationships
  application PropertyApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author      User                @relation("applicationComments", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_comments")
}

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  ownerId     String
  status      ProjectStatus @default(INITIALIZED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relationships
  owner       User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parcels     Parcel[]
  assignments ProjectAssignment[]
  application PropertyApplication?

  @@map("projects")
}

model ProjectAssignment {
  id             String   @id @default(uuid())
  projectId      String
  userId         String
  assignmentRole String   // The role this user plays on this project (e.g. SURVEYOR, REVIEWER)
  assignedById   String?
  assignedAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relationships
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User    @relation("userAssignments", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User?   @relation("assignmentsMade", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, projectId])
  @@map("project_assignments")
}

model Parcel {
  id           String   @id @default(uuid())
  projectId    String
  name         String
  parcelNumber String?
  area         Float?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildings Building[]

  @@map("parcels")
}

model Building {
  id             String   @id @default(uuid())
  parcelId       String
  name           String
  numberOfFloors Int      @default(1)
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relationships
  parcel Parcel  @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  floors Floor[]

  @@map("buildings")
}

model Floor {
  id         String   @id @default(uuid())
  buildingId String
  level      Int
  elevation  Float    @default(0.0)
  height     Float    @default(3.0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relationships
  building      Building       @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  spatialAssets SpatialAsset[]

  @@map("floors")
}

model SpatialAsset {
  id        String    @id @default(uuid())
  floorId   String
  name      String
  type      AssetType @default(PROPERTY_UNIT)
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relationships
  floor            Floor             @relation(fields: [floorId], references: [id], onDelete: Cascade)
  geometryVersions GeometryVersion[]
  violations       Violation[]

  @@map("spatial_assets")
}

model GeometryVersion {
  id             String   @id @default(uuid())
  spatialAssetId String
  version        Int      @default(1)
  source         String?  // e.g. 'manual', 'ai_extrusion', 'cad_import'
  status         String   @default("active") // 'active', 'archived', 'draft'
  geometryData   Json?    // Structured GeoJSON / 3D polyhedral representation
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relationships
  spatialAsset SpatialAsset @relation(fields: [spatialAssetId], references: [id], onDelete: Cascade)

  @@unique([spatialAssetId, version])
  @@map("geometry_versions")
}

model ProcessingJob {
  id            String              @id @default(uuid())
  type          String              // e.g. 'ai_extrusion', 'clash_detection', 'watertightness_check'
  status        ProcessingJobStatus @default(PENDING)
  inputData     Json?
  outputData    Json?
  errorMessage  String?
  requestedById String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  // Relationships
  requestedBy User? @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  @@map("processing_jobs")
}

model Violation {
  id             String            @id @default(uuid())
  spatialAssetId String
  type           ViolationType     @default(OTHER)
  severity       ViolationSeverity @default(MEDIUM)
  description    String
  resolved       Boolean           @default(false)
  details        Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // Relationships
  spatialAsset SpatialAsset @relation(fields: [spatialAssetId], references: [id], onDelete: Cascade)

  @@map("violations")
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String   // e.g. 'CREATE', 'UPDATE', 'DELETE', 'VERIFY', 'PROCESS'
  entityType String   // e.g. 'SpatialAsset', 'Project', 'GeometryVersion'
  entityId   String
  userId     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  // Relationships
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@map("audit_logs")
}
