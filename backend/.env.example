# ─── Environment ──────────────────────────────────────────
# Application environment: development | production | test
NODE_ENV=development

# Port the Express server listens on
PORT=3001

# ─── Database ─────────────────────────────────────────────
# Local PostgreSQL + PostGIS:
DATABASE_URL=postgresql://strata:strata@localhost:5432/strata_db
# Or Supabase Cloud Database:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# SUPABASE_URL=https://[PROJECT-REF].supabase.co
# SUPABASE_ANON_KEY=sb_publishable_...

# ─── Authentication ───────────────────────────────────────
# Secret key for signing JWTs (CHANGE THIS in production)
JWT_SECRET=change-me-in-production-use-a-long-random-string

# JWT token expiration (e.g., 7d, 24h, 3600s)
JWT_EXPIRES_IN=7d

# ─── External Services ───────────────────────────────────
# URL of the Python/FastAPI processing service
PYTHON_PROCESSING_SERVICE_URL=http://localhost:8000

# ─── CORS ─────────────────────────────────────────────────
# Allowed origin for CORS (frontend URL)
CORS_ORIGIN=http://localhost:3000
